{
  "comment": "An office's ten verbs as a kernel catalogue (the tool rows an office service ships, copied as they are): test data for the frame parts and the cards they must never steal a sentence from.",
  "schema_version": "kernel-catalogue/v1",
  "tools": [
    {"name": "look", "description": "The tickets in a place: the inbox, a lane of the board, someone's desk, or the archive.", "input_schema": {"type": "object", "properties": {"place": {"type": "string", "description": "the inbox, a lane, a person's desk, or the archive"}}, "required": ["place"]}, "x-args": {"place": {"role": "location"}}, "x-side-effect": false, "x-consent": "speaker_turn", "x-forms": ["look at {place}", "look in {place}"]},
    {"name": "take", "description": "Assign a ticket to the speaker; returns the ticket.", "input_schema": {"type": "object", "properties": {"ticket": {"type": "string", "description": "the ticket's identifier (BRA-12) or title"}}, "required": ["ticket"]}, "x-args": {"ticket": {"role": "theme", "kind": "Artifact"}}, "x-returns": {"of": "ticket"}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["take {ticket}", "take {ticket} from the inbox"]},
    {"name": "put", "description": "Move a ticket to a lane of the board or the inbox (its status), or onto a person's desk (its assignee).", "input_schema": {"type": "object", "properties": {"ticket": {"type": "string", "description": "the ticket's identifier or title"}, "place": {"type": "string", "description": "a lane, the inbox, or a person's desk"}}, "required": ["ticket", "place"]}, "x-args": {"ticket": {"role": "theme", "kind": "Artifact"}, "place": {"role": "location"}}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["put {ticket} on {place}", "put {ticket} in {place}"]},
    {"name": "give", "description": "Assign a ticket to a person who has a desk.", "input_schema": {"type": "object", "properties": {"ticket": {"type": "string", "description": "the ticket's identifier or title"}, "person": {"type": "string", "description": "a person in the office (their Telegram username), or me"}}, "required": ["ticket", "person"]}, "x-args": {"ticket": {"role": "theme", "kind": "Artifact"}, "person": {"role": "recipient"}}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["give {ticket} to {person}"]},
    {"name": "comment", "description": "Add a comment to a ticket.", "input_schema": {"type": "object", "properties": {"body": {"type": "string", "description": "the comment"}, "ticket": {"type": "string", "description": "the ticket's identifier or title"}}, "required": ["body", "ticket"]}, "x-args": {"body": {"role": "theme"}, "ticket": {"role": "location", "kind": "Artifact"}}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["comment {body} on {ticket}"]},
    {"name": "make", "description": "Make a ticket in the inbox from a title or a message; returns the new ticket.", "input_schema": {"type": "object", "properties": {"title": {"type": "string", "description": "the ticket's title (a long text becomes its description)"}}, "required": ["title"]}, "x-args": {"title": {"role": "theme", "kind": "Artifact"}}, "x-returns": {"of": "title"}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["make a ticket from {title}", "make a ticket for {title}"]},
    {"name": "archive", "description": "Close a ticket (it goes to the archive). Needs the board's approval.", "input_schema": {"type": "object", "properties": {"ticket": {"type": "string", "description": "the ticket's identifier or title"}}, "required": ["ticket"]}, "x-args": {"ticket": {"role": "theme", "kind": "Artifact"}}, "x-side-effect": true, "x-consent": "confirm", "x-forms": ["archive {ticket}"]},
    {"name": "write", "description": "Write a note on the notepad.", "input_schema": {"type": "object", "properties": {"body": {"type": "string", "description": "the note"}}, "required": ["body"]}, "x-args": {"body": {"role": "theme"}}, "x-side-effect": true, "x-consent": "speaker_turn", "x-forms": ["write {body}", "write {body} on the notepad"]},
    {"name": "read", "description": "Read the notepad's latest notes.", "input_schema": {"type": "object", "properties": {}}, "x-args": {}, "x-side-effect": false, "x-consent": "speaker_turn", "x-forms": ["read the notepad", "read the notes"]},
    {"name": "search", "description": "Search the team's memory (read-only).", "input_schema": {"type": "object", "properties": {"query": {"type": "string", "description": "what to look for"}}, "required": ["query"]}, "x-args": {"query": {"role": "theme"}}, "x-side-effect": false, "x-consent": "speaker_turn", "x-forms": ["search {query}", "search for {query}"]}
  ]
}
